{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adventure Log: main quests",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "title", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": ["job", "education", "certification", "assessment", "milestone", "goal"]
          },
          "status": {
            "enum": ["completed", "active"]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "org": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "object",
            "required": ["start"],
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
              },
              "end": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "_source": {
            "type": "string"
          },
          "_review": {
            "type": "boolean"
          },
          "_placeholder": {
            "type": "boolean"
          },
          "_note": {
            "type": "string"
          }
        }
      }
    }
  }
}
