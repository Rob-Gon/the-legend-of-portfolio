{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory: weapons (technologies)",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "level", "icon", "usedIn", "studiedIn"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": ["core", "secondary", "tools", "office"]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "icon": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "usedIn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "studiedIn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "_source": {
            "type": "string"
          },
          "_review": {
            "type": "boolean"
          },
          "_placeholder": {
            "type": "boolean"
          },
          "_note": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        }
      }
    }
  }
}
