{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adventure Log: side quests",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "_source": {
            "type": "string"
          },
          "_review": {
            "type": "boolean"
          },
          "_placeholder": {
            "type": "boolean"
          },
          "_note": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["href", "label"],
              "additionalProperties": false,
              "properties": {
                "href": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
