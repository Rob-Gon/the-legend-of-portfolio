{
  "name": "the-legend-of-roberto",
  "version": "0.1.0",
  "private": true,
  "description": "Personal portfolio of Roberto Báez González with a game-menu inspired interface. Unofficial fan project, not affiliated with Nintendo.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint \"src/**/*.scss\" && prettier --check .",
    "format": "prettier --write . && eslint --fix . && stylelint --fix \"src/**/*.scss\"",
    "model:optimize": "gltf-transform optimize assets-src/avatar.raw.glb public/models/avatar.glb --compress meshopt --flatten false --join false --palette false --simplify false --instance false --texture-compress false"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.65.1",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
